{
	"schemaVersion": 1,
	"id": "metacraft-config-gui",
	"version": "${version}",
	"name": "METAcraft Config GUI",
	"description": "Config GUI for METAcraft",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"se.metacraft.config_gui.ConfigGUI"
		]
	},
	"mixins": [
		"metacraft-config-gui.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"metacraft-lib": "*",
		"metacraft-config": "*"
	},
	"suggests": {
		"leukocyte": "*"
	}
}
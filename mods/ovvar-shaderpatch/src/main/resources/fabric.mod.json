{
	"schemaVersion": 1,
	"id": "ovvar-shaderpatch",
	"version": "${version}",
	"name": "Ovvar Shader Patch",
	"description": "Patches the shaderpacks in the instance at startup so ovvar (student overalls) and the rift shaders render under Iris. Client only.",
	"authors": [
		"Froosty11"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"se.metacraft.ovvarshaderpatch.PreLaunch"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}"
	}
}

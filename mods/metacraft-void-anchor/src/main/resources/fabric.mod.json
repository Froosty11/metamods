{
	"schemaVersion": 1,
	"id": "metacraft-void-anchor",
	"version": "${version}",
	"name": "METAcraft-Void-Anchor",
	"description": "A respawn-anchor-like block that catches you when you fall into the End void.",
	"authors": [
		"Froosty11"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.void_anchor.VoidAnchor"
		],
		"fabric-datagen": [
			"nu.metacraft.void_anchor.VoidAnchorDatagen"
		]
	},
	"mixins": [
		"metacraft_void_anchor.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "~${minecraft_version}",
		"metacraft-lib": "*",
		"metacraft-core": "*"
	}
}
